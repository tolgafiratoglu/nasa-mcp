# Get your API key at https://api.nasa.gov/
# DEMO_KEY: 30 req/hour, 50 req/day per IP
# Registered key: 1000 req/hour
NASA_API_KEY=DEMO_KEY

# --- LLM provider (same contract as travel-rag) ---
# gemini = Google Gemini API (cloud)
# qwen   = local Qwen via Ollama (offline)
LLM_PROVIDER=gemini

# Gemini (when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash-lite
# Secrets (GEMINI_API_KEY) — same file as travel-rag:
SECRETS_ENV_PATH=~/.config/rag/.env
# Or set inline:
# GEMINI_API_KEY=

# --- Qwen via Ollama (when LLM_PROVIDER=qwen) ---
# Active size: 1b (QWEN1B) or 8b (QWEN8B) — same as travel-rag
QWEN_LLM=1b
QWEN8B=qwen3:8b
QWEN1B=qwen3:1.7b-q4_K_M
# Host default (travel-rag Docker uses http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434

# --- Web API ---
# FastAPI: http://127.0.0.1:8100  (travel-rag uses 8000)
# Next.js: http://localhost:3100  (travel-rag uses 3000)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100

# --- Observability ---
# OTEL_CONSOLE=1
